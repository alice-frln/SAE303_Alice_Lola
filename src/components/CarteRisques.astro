---
// Route A / C : rendu au build, le lecteur ne reçoit que le SVG.
import { JSDOM } from "jsdom";
import { carteRisques } from "../charts/carteRisques.js";
import { simplifierTraces } from "../lib/svg.js";

const { donnees, titre, sousTitre, source, alt } = Astro.props;

const figure = carteRisques(donnees, {
  width: 720,
  titre,
  sousTitre,
  source,
  alt,
  document: new JSDOM("").window.document,
});
simplifierTraces(figure);
---

<figure class="map-panel overflow-hidden border border-forest/20 bg-paper p-3 shadow-sm sm:p-6" set:html={figure.outerHTML} />
