---
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";
const { options } = Astro.props;

const plot = Plot.plot({ ...options, document: new JSDOM("").window.document });
plot.style.maxWidth = "100%";
plot.style.height = "auto";
---

<figure class="plot-panel overflow-hidden border border-forest/20 bg-paper p-3 shadow-sm sm:p-6" set:html={plot.outerHTML} />
