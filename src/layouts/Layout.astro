---
import "../styles/global.css";
import logo from "../assets/img/logo_noir_sae.svg?url";
const { title = "SAÉ – Déchets dangereux et risques industriels" } = Astro.props;

const chemin = Astro.url.pathname;
const actif = (href) => (href === "/" ? chemin === "/" : chemin.startsWith(href));

const liensHeader = [
  { href: "/glossaire/", texte: "Glossaire" },
  { href: "/production-dechets/", texte: "Production et gestion des déchets" },
  { href: "/enquetes/", texte: "Enquêtes" },
  { href: "/methode/", texte: "Méthode" },
];
const liensFooter = [
  { href: "/contact/", texte: "Contact" },
  { href: "/a-propos/", texte: "À propos" },
  { href: "/mentions-legales/", texte: "Mentions légales" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Aguafina+Script&family=Funnel+Display:wght@300..800&family=Inter:wght@100;200;300;400;500;600;700;800;900&family=League+Gothic&family=Mona+Sans:ital,wght@0,200..900;1,200..900&family=Playfair+Display:wght@700&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-rose text-ink antialiased">
    <header class="border-b border-ink bg-forest text-white">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-5 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
        <a
          href="/"
          aria-label="Accueil"
          aria-current={actif("/") ? "page" : undefined}
          class="group flex size-12 items-center justify-center self-start text-white no-underline lg:self-center"
        >
          <img src={logo} alt="" class="size-10 object-contain brightness-0 invert" />
        </a>
        <nav aria-label="Navigation principale" class="font-sans text-base font-medium tracking-wide">
          <ul class="m-0 flex list-none flex-wrap items-center gap-x-7 gap-y-2 p-0 sm:gap-x-9">
            {
              liensHeader.map(({ href, texte }) => (
                <li>
                  <a
                    class:list={[
                      "block py-2 text-white no-underline transition-opacity hover:opacity-75",
                      actif(href) && "underline decoration-2 underline-offset-8",
                    ]}
                    href={href}
                    aria-current={actif(href) ? "page" : undefined}
                  >
                    {texte}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-7 sm:px-8 sm:py-10">
      <slot />
    </main>

    <footer class="border-t border-forest/20 bg-paper">
      <nav aria-label="Informations sur le site" class="mx-auto max-w-7xl px-5 py-5 font-sans text-sm font-medium tracking-wide text-forest/70 sm:px-8">
        <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
          {
            liensFooter.map(({ href, texte }) => (
              <li>
                <a href={href} aria-current={actif(href) ? "page" : undefined}>
                  {texte}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </footer>
  </body>
</html>
