---
import "../styles/global.css";
const { title = "SAÉ – Déchets dangereux et risques industriels" } = Astro.props;

const chemin = Astro.url.pathname;
const actif = (href) => (href === "/" ? chemin === "/" : chemin.startsWith(href));

const liensHeader = [
  { href: "/glossaire/", texte: "Glossaire" },
  { href: "/production-dechets/", texte: "Production et gestion des déchets" },
  { href: "/enquetes/", texte: "Enquêtes" },
  { href: "/sources/", texte: "Sources des données" },
];
const liensFooter = [
  { href: "/contact/", texte: "Contact" },
  { href: "/a-propos/", texte: "À propos" },
  { href: "/mentions-legales/", texte: "Mentions légales" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Aguafina+Script&family=Funnel+Display:wght@300..800&family=Inter:wght@100;200;300;400;500;600;700;800;900&family=League+Gothic&family=Mona+Sans:ital,wght@0,200..900;1,200..900&family=Playfair+Display:wght@700&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Navigation principale">
        <!-- Bouton provisoire, remplacé plus tard par un SVG -->
        <a href="/" aria-current={actif("/") ? "page" : undefined}>Accueil</a>
        <ul>
          {
            liensHeader.map(({ href, texte }) => (
              <li>
                <a href={href} aria-current={actif(href) ? "page" : undefined}>
                  {texte}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <nav aria-label="Informations sur le site">
        <ul>
          {
            liensFooter.map(({ href, texte }) => (
              <li>
                <a href={href} aria-current={actif(href) ? "page" : undefined}>
                  {texte}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </footer>
  </body>
</html>
