---
import Layout from "../../layouts/Layout.astro";
import CarteRisques from "../../components/CarteRisques.astro";
import SelectCommune from "../../components/SelectCommune.astro";
import { donneesCarteRisques } from "../../data/carteRisques.js";

const { etablissements, basol, pprt } = donneesCarteRisques;
const etabPprt = etablissements.filter((e) => e.dansPprt).length;
const basolPprt = basol.filter((b) => b.dansPprt).length;
---

<Layout>
  <main class="mx-auto max-w-3xl space-y-4 p-4">
    <SelectCommune />
    <CarteRisques
      donnees={donneesCarteRisques}
      titre="Les zones potentiellement polluées en fonction des emplacements des établissements rejetant des déchets dangereux"
      sousTitre="Il existe une concentration des enquêtes sur la qualité des sols tout autour des entreprises mais également vers le centre de Bordeaux. Même sans avoir les résultats, on note une réelle inquiétude quant à la qualité des sols dans les zones industrielles mais également habitées."
      source="Sources : établissements polluants, sites et sols pollués (BASOL), plans de prévention des risques technologiques, limites communales (Bordeaux Métropole, 28 communes). BASOL : base nationale des sites et sols pollués ou potentiellement pollués ; une croix par fiche. Les habitations ne sont pas représentées."
      alt={`Carte de Bordeaux Métropole avec ${etablissements.length} établissements polluants représentés par des points, ${basol.length} sites BASOL (dossiers de sols pollués ou potentiellement pollués, dont on ne connaît que le statut d'instruction) représentés par des croix et ${pprt.length} zones de plan de prévention des risques technologiques. Les zones PPRT sont concentrées autour d'Ambès, de Bassens et de Saint-Médard-en-Jalles. ${etabPprt} établissements sur ${etablissements.length} et ${basolPprt} sites pollués sur ${basol.length} sont dans une zone PPRT ; la plupart sont dispersés dans le reste de la métropole, surtout à Bordeaux, Mérignac et sur la rive droite.`}
    />
  </main>
</Layout>
